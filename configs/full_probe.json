{
  "vision_model": "models/MonkeyOCRv2-B",
  "language_model": "models/Qwen3-1.7B",
  "data_dir": "data/full_probe",
  "output_dir": "artifacts/full_probe",
  "seed": 42,
  "device": "cpu",
  "dtype": "float32",
  "vision_dtype": "float32",
  "mixed_precision": null,
  "vision_attention": "eager",
  "threads": 16,
  "max_pixels": 12544,
  "min_pixels": 3136,
  "max_sequence_length": 8196,
  "max_answer_tokens": 2048,
  "max_new_tokens": 8,
  "stage1_epochs": 1,
  "stage1_lr": 0.001,
  "stage2_epochs": 1,
  "stage2_lr": 1e-05,
  "micro_batch_size": 2,
  "effective_batch_size": 4,
  "warmup_ratio": 0.05,
  "weight_decay": 0.01,
  "adam_beta2": 0.999,
  "gradient_clip": 1.0,
  "gradient_checkpointing": true,
  "feature_cache_limit": 8,
  "checkpoint_steps": 1,
  "validation_steps": 100,
  "validation_samples_per_task": 64,
  "eval_splits": [
    "val",
    "test"
  ],
  "eval_scope": "Public-data engineering probe only, not full benchmark"
}